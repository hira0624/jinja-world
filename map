<!doctype html>
<html lang="ja">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>神社マップ</title>
  <!-- Leaflet -->
  <link
    rel="stylesheet"
    href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
    integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY="
    crossorigin=""
  />
  <script
    src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
    integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo="
    crossorigin=""
  ></script>
  <style>
    html, body, #map { height: 100%; margin: 0; }
    .topbar {
      position: fixed; left: 12px; top: 12px; z-index: 1000;
      background: rgba(255,255,255,.95); padding: 10px 12px; border-radius: 12px;
      box-shadow: 0 6px 18px rgba(0,0,0,.12); font-family: system-ui, -apple-system, "Noto Sans JP", sans-serif;
    }
    .topbar h1 { margin: 0 0 6px; font-size: 16px; }
    .topbar small { opacity: .7; }
    .leaflet-popup-content p { margin: 6px 0; }
    .enter-btn {
      display: inline-block; padding: 6px 10px; border-radius: 10px; text-decoration: none;
      background: #2563eb; color: #fff; font-weight: 700;
    }
  </style>
</head>
<body>
  <div class="topbar">
    <h1>神社マップ</h1>
    <small>ピンをクリック → <b>この神社に入る</b> で3Dへ</small>
  </div>
  <div id="map"></div>

  <script>
    // --- 神社データ（ここを自由に編集） ---
    const SHRINES = [
      {
        id: 'meiji',
        name: '明治神宮',
        lat: 35.676398, lng: 139.699326,
        desc: '都心の杜に鎮まる大社。'
      },
      {
        id: 'kanda',
        name: '神田明神',
        lat: 35.702232, lng: 139.767101,
        desc: '江戸総鎮守。商売繁盛・縁結び。'
      },
      {
        id: 'asakusa',
        name: '浅草神社（浅草）',
        lat: 35.714765, lng: 139.796655,
        desc: '浅草寺の東隣。三社祭で有名。'
      },
      {
        id: 'fushimi',
        name: '伏見稲荷大社（京都）',
        lat: 34.967140, lng: 135.772672,
        desc: '千本鳥居で知られる稲荷総本宮。'
      }
    ];

    // URL パラメータ（center=lat,lng&zoom=15 や id=meiji を解釈）
    const params = new URLSearchParams(location.search);
    const centerParam = params.get('center');
    const zoomParam = parseInt(params.get('zoom') || '12', 10);
    const idParam = params.get('id');

    // 初期中心：パラメータ優先 → 明治神宮
    let center = [35.676398, 139.699326];
    if (centerParam) {
      const [lat, lng] = centerParam.split(',').map(Number);
      if (Number.isFinite(lat) && Number.isFinite(lng)) center = [lat, lng];
    } else if (idParam) {
      const t = SHRINES.find(s => s.id === idParam);
      if (t) center = [t.lat, t.lng];
    }

    // Leaflet マップ
    const map = L.map('map', { zoomControl: true }).setView(center, zoomParam);
    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
      maxZoom: 19,
      attribution:
        '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors'
    }).addTo(map);

    // マーカー設置
    SHRINES.forEach(s => {
      const marker = L.marker([s.lat, s.lng]).addTo(map);
      const href = `shrine.html?id=${encodeURIComponent(s.id)}`;
      marker.bindPopup(`
        <div style="min-width:200px">
          <b>${s.name}</b>
          <p>${s.desc}</p>
          <a class="enter-btn" href="${href}">この神社に入る</a>
        </div>
      `);
      // id=? で来たら該当ポップアップを開く
      if (idParam === s.id) {
        marker.openPopup();
      }
    });

    // 将来：現在地に移動するボタンなども追加可能
  </script>
</body>
</html>
