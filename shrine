<!doctype html>
<html lang="ja">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>神社 3D マップ</title>
  <script src="https://aframe.io/releases/1.5.0/aframe.min.js"></script>
  <style>
    body { margin: 0; font-family: system-ui, -apple-system, "Noto Sans JP", sans-serif; }
    .hint { position: fixed; top: 12px; left: 50%; transform: translateX(-50%);
      background: rgba(0,0,0,.6); color: #fff; padding: 6px 10px; border-radius: 999px; font-size: 12px; z-index: 10; }
    .ui {
      position: fixed; left: 12px; bottom: 12px; z-index: 10;
      background: rgba(255,255,255,0.9); backdrop-filter: blur(6px);
      border-radius: 12px; box-shadow: 0 8px 24px rgba(0,0,0,.15);
      padding: 12px; display: grid; gap: 8px; width: min(92vw, 380px);
    }
    .panel {
      position: fixed; right: 12px; bottom: 12px; z-index: 10;
      background: rgba(255,255,255,0.96); border-radius: 12px; padding: 12px;
      box-shadow: 0 8px 24px rgba(0,0,0,.15); width: min(92vw, 420px);
    }
    button, select, input, textarea {
      border-radius: 10px; padding: 10px 12px; border: 1px solid #e5e7eb;
      background: white; font-weight: 600; cursor: pointer;
    }
    .backbtn {
      position: fixed; right: 12px; top: 12px; z-index: 10;
      background: rgba(255,255,255,0.96); padding: 10px 12px; border-radius: 12px;
      box-shadow: 0 8px 24px rgba(0,0,0,.15); text-decoration: none; color: #111; font-weight: 800;
    }
    .fortune { font-size: 28px; font-weight: 800; }
    canvas { width: 100%; height: auto; border-radius: 8px; border: 1px solid #e5e7eb; }
    .board { display: grid; gap: 8px; }
    .comments { max-height: 240px; overflow: auto; padding: 8px; border: 1px solid #e5e7eb; border-radius: 8px; background: #fff; }
    .comment { padding: 6px 8px; border-bottom: 1px dashed #e5e7eb; }
    .comment:last-child { border-bottom: none; }
    .comment .meta { font-size: 12px; opacity:.7; }
  </style>
</head>
<body>
  <div class="hint">WASD/矢印で移動・ドラッグで視点 / 画面中央のリングで狙ってクリック / 右上「地図へ戻る」で外に出る</div>
  <a id="backLink" class="backbtn" href="map.html">地図へ戻る</a>

  <!-- 左下 UI（お守り＋御朱印） -->
  <div class="ui">
    <div><b id="shrineName">神社</b></div>
    <div style="display:grid; grid-template-columns: 1fr 1fr; gap:8px;">
      <button id="makeOmamori">お守り生成</button>
      <button id="makeGoshuin">御朱印プレビュー</button>
    </div>
  </div>

  <!-- 右下パネル（おみくじ/賽銭/御朱印/絵馬掲示板 兼用） -->
  <div class="panel" id="sidePanel" hidden>
    <h2 id="panelTitle"></h2>
    <div id="omikujiResult" class="fortune"></div>
    <canvas id="goshuinCanvas" width="640" height="900" hidden></canvas>
    <div id="emaBoard" class="board" hidden>
      <div class="comments" id="emaComments"></div>
      <div style="display:grid; gap:8px; margin-top:6px;">
        <input type="text" id="nameInput" placeholder="お名前（任意）">
        <textarea id="msgInput" rows="3" placeholder="願いごとやメッセージ"></textarea>
        <button id="postBtn">投稿する</button>
        <div style="font-size:12px; opacity:.7;">（この端末のみに保存されます）</div>
      </div>
    </div>
    <div style="display:flex; gap:8px; margin-top:8px;">
      <button id="downloadBtn" hidden>御朱印をダウンロード</button>
      <button id="closePanel">閉じる</button>
    </div>
  </div>

  <!-- 3D シーン -->
  <a-scene background="color: #e6f0ff">
    <!-- カメラ（リングカーソル + raycaster + 矢印移動） -->
    <a-entity id="rig" position="0 1.6 4" arrow-move="speed: 3">
      <a-entity camera look-controls wasd-controls="acceleration: 20"
                cursor="rayOrigin: mouse"
                raycaster="objects: .clickable; interval: 50">
        <a-entity position="0 0 -1"
                  geometry="primitive: ring; radiusInner: 0.01; radiusOuter: 0.015"
                  material="color: #ffffff; shader: flat; opacity: 0.9"></a-entity>
      </a-entity>
    </a-entity>

    <!-- 地面 -->
    <a-entity geometry="primitive: plane; width: 46; height: 40" rotation="-90 0 0"
              material="color: #d9ead3; roughness: 1"></a-entity>

    <!-- 鳥居（正面） -->
    <a-entity id="gateExit" position="0 0 -2" class="clickable">
      <a-box class="clickable" color="#b91c1c" width="4" height="0.25" depth="0.4" position="0 2 0"></a-box>
      <a-box class="clickable" color="#991b1b" width="4.4" height="0.15" depth="0.45" position="0 2.2 0"></a-box>
      <a-box class="clickable" color="#7f1d1d" width="0.25" height="2" depth="0.25" position="-1.6 1 0"></a-box>
      <a-box class="clickable" color="#7f1d1d" width="0.25" height="2" depth="0.25" position="1.6 1 0"></a-box>
      <a-text value="出口：地図へ" align="center" width="6" position="0 0.2 0.6" color="#0f172a"></a-text>
    </a-entity>

    <!-- 社殿 -->
    <a-entity id="shrine" position="0 0 -8">
      <a-box color="#8b5cf6" width="6" height="3" depth="5" position="0 1.5 0"></a-box>
      <a-cone color="#6d28d9" radius-bottom="3.6" height="1.2" position="0 3 0"></a-cone>
      <a-text value="拝殿" align="center" width="6" position="0 3.4 2.6"></a-text>
    </a-entity>

    <!-- おみくじ -->
    <a-entity id="omikujiBox" position="-2 0.8 -5" class="clickable">
      <a-box class="clickable" color="#7c2d12" width="1.2" height="0.8" depth="1"></a-box>
      <a-text value="おみくじ" align="center" width="3" position="0 0.7 0.6"></a-text>
    </a-entity>

    <!-- 賽銭箱 -->
    <a-entity id="saisenBox" position="0 0.6 -6" class="clickable">
      <a-box class="clickable" color="#a16207" width="1.8" height="0.6" depth="1"></a-box>
      <a-text value="賽銭箱" align="center" width="3" position="0 0.7 0.6"></a-text>
    </a-entity>

    <!-- お守り置き場 -->
    <a-entity id="omamoriRack" position="2 0 -6">
      <a-box color="#e5e7eb" width="2.6" height="1.2" depth="0.2" position="0 1 0"></a-box>
      <a-text value="お守り" align="center" width="4" position="0 1.7 0"></a-text>
    </a-entity>

    <!-- 絵馬掛け（右） -->
    <a-entity id="emaWall" position="6 0 -8">
      <a-box color="#cbd5e1" width="4.5" height="2.8" depth="0.2" position="0 1.4 0"></a-box>
      <a-text value="絵馬掛け" align="center" width="6" position="0 3 0.2" color="#0f172a"></a-text>
    </a-entity>

    <!-- ライト -->
    <a-entity light="type: ambient; intensity: 0.6"></a-entity>
    <a-entity light="type: directional; intensity: 0.8" position="1 3 1"></a-entity>
  </a-scene>

  <script>
    // ======== 神社データ（map.html と揃える） ========
    const SHRINES = [
      { id: 'meiji',  name: '明治神宮', lat: 35.676398, lng: 139.699326 },
      { id: 'kanda',  name: '神田明神', lat: 35.702232, lng: 139.767101 },
      { id: 'asakusa',name: '浅草神社（浅草）', lat: 35.714765, lng: 139.796655 },
      { id: 'fushimi',name: '伏見稲荷大社（京都）', lat: 34.967140, lng: 135.772672 }
    ];
    const params = new URLSearchParams(location.search);
    const shrineId = params.get('id') || 'meiji';
    const shrine = SHRINES.find(s => s.id === shrineId) || SHRINES[0];
    document.getElementById('shrineName').textContent = shrine.name;
    // 地図へ戻るリンク（中心を同じに）
    document.getElementById('backLink').href =
      `map.html?center=${shrine.lat},${shrine.lng}&zoom=15&id=${encodeURIComponent(shrine.id)}`;

    // ====== パネル切替 ======
    const sidePanel = document.getElementById('sidePanel');
    const panelTitle = document.getElementById('panelTitle');
    const omikujiResult = document.getElementById('omikujiResult');
    const goshuinCanvas = document.getElementById('goshuinCanvas');
    const downloadBtn = document.getElementById('downloadBtn');
    const emaBoard = document.getElementById('emaBoard');
    const emaCommentsEl = document.getElementById('emaComments');
    const nameInput = document.getElementById('nameInput');
    const msgInput = document.getElementById('msgInput');
    const postBtn = document.getElementById('postBtn');
    let currentEmaId = null;

    function showPanelOmikuji(html) {
      panelTitle.textContent = 'おみくじ結果';
      omikujiResult.innerHTML = html;
      goshuinCanvas.hidden = true; downloadBtn.hidden = true; emaBoard.hidden = true;
      sidePanel.hidden = false;
    }
    function showPanelGoshuin() {
      panelTitle.textContent = '御朱印（プレビュー）';
      omikujiResult.innerHTML = '';
      goshuinCanvas.hidden = false; downloadBtn.hidden = false; emaBoard.hidden = true;
      sidePanel.hidden = false;
    }
    function showPanelEma(emaId) {
      currentEmaId = emaId;
      panelTitle.textContent = `絵馬掲示板 (#${emaId})`;
      omikujiResult.innerHTML = '';
      goshuinCanvas.hidden = true; downloadBtn.hidden = true; emaBoard.hidden = false;
      renderEmaComments(emaId);
      sidePanel.hidden = false;
    }
    document.getElementById('closePanel').addEventListener('click', ()=> sidePanel.hidden = true);

    // ===== おみくじ =====
    const fortunes = [
      {name: '大吉', desc: '最高の運気。願い事は叶いやすい。'},
      {name: '中吉', desc: '良い兆しが見える。焦らず進めば吉。'},
      {name: '小吉', desc: '小さな幸運。身の回りに感謝を。'},
      {name: '吉',   desc: '穏やかに上向き。継続は力なり。'},
      {name: '末吉', desc: '今は準備のとき。土台を固めよう。'},
      {name: '凶',   desc: '慎重に。無理をしなければ回避可。'}
    ];
    document.getElementById('omikujiBox').addEventListener('click', () => {
      const f = fortunes[Math.floor(Math.random() * fortunes.length)];
      showPanelOmikuji(`<div class="fortune">${f.name}</div><div>${f.desc}</div>`);
      pulse(document.getElementById('omikujiBox'));
    });

    // ===== 賽銭箱 =====
    let donationTotal = 0;
    document.getElementById('saisenBox').addEventListener('click', () => {
      donationTotal += 5;
      dropCoin({x: 0, y: 2.2, z: -6});
      showPanelOmikuji(`<div>チャリン…（+5円）</div><div style="margin-top:6px;">合計：<b>${donationTotal}円</b></div>`);
      pulse(document.getElementById('saisenBox'));
    });
    function dropCoin(pos) {
      const coin = document.createElement('a-cylinder');
      coin.setAttribute('radius', '0.08'); coin.setAttribute('height', '0.02');
      coin.setAttribute('color', '#f59e0b'); coin.setAttribute('position', `${pos.x} ${pos.y} ${pos.z}`);
      coin.setAttribute('animation__fall', 'property: position; to: 0 0.95 -6; dur: 700; easing: easeOutQuad');
      coin.setAttribute('animation__spin', 'property: rotation; to: 0 0 720; dur: 700; easing: linear');
      document.querySelector('a-scene').appendChild(coin);
      setTimeout(()=> coin.remove(), 900);
    }

    // ===== 御朱印（Canvas） =====
    const c = goshuinCanvas; const ctx = c.getContext('2d');
    function makeGoshuinImage() {
      const now = new Date();
      ctx.fillStyle = '#faf6f1'; ctx.fillRect(0,0,c.width,c.height);
      ctx.beginPath(); ctx.arc(320, 180, 120, 0, Math.PI*2);
      ctx.fillStyle = '#e11d48'; ctx.fill();
      ctx.fillStyle = '#111827'; ctx.textAlign = 'center';
      ctx.font = '700 48px "Hiragino Kaku Gothic ProN", "Noto Sans JP"';
      ctx.fillText(shrine.name, 320, 360);
      ctx.font = '600 28px "Hiragino Kaku Gothic ProN", "Noto Sans JP"';
      const y = now.getFullYear(), m = String(now.getMonth()+1).padStart(2,'0'), d = String(now.getDate()).padStart(2,'0');
      ctx.fillText(`${y}年${m}月${d}日`, 320, 410);
      ctx.strokeStyle = '#dc2626'; ctx.lineWidth = 8; ctx.strokeRect(140, 520, 360, 260);
      ctx.font = '800 64px "Hiragino Kaku Gothic ProN", "Noto Sans JP"'; ctx.fillStyle = '#dc2626';
      ctx.fillText('御朱印', 320, 660);
    }
    document.getElementById('makeGoshuin').addEventListener('click', ()=>{ makeGoshuinImage(); showPanelGoshuin(); });
    downloadBtn.addEventListener('click', () => {
      const a = document.createElement('a'); a.href = c.toDataURL('image/png');
      const now = new Date();
      const y = now.getFullYear(), m = String(now.getMonth()+1).padStart(2,'0'), d = String(now.getDate()).padStart(2,'0');
      a.download = `goshuin_${shrine.id}_${y}${m}${d}.png`; a.click();
    });

    // ===== お守り生成 =====
    const rack = document.getElementById('omamoriRack');
    document.getElementById('makeOmamori').addEventListener('click', () => {
      const count = rack.children.length;
      const colors = ['#6B5C82','#e11d48','#2563eb','#16a34a','#f59e0b'];
      const wishes = ['合格祈願','恋愛成就','商売繁盛','健康長寿','交通安全'];
      const color = colors[count % colors.length];
      const wish = wishes[count % wishes.length];
      const x = (count % 5) * 0.5 - 1.0;
      const y = 1.2 - Math.floor(count / 5) * 0.6;
      const z = 0.1;
      const omamori = document.createElement('a-entity');
      omamori.setAttribute('position', `${x} ${y} ${z}`);
      omamori.innerHTML = `
        <a-box color="${color}" width="0.28" height="0.38" depth="0.05"></a-box>
        <a-text value="${wish}" align="center" width="1.2" position="0 0.02 0.04" color="#111827"></a-text>
        <a-torus color="#f1f5f9" radius="0.05" radius-tubular="0.01" position="0 0.24 0"></a-torus>
      `;
      rack.appendChild(omamori);
    });

    // ===== 絵馬（自動生成 & 掲示板） =====
    const emaWall = document.getElementById('emaWall');
    const EMA_ROWS = 4, EMA_COLS = 6;
    const START_X = -1.9, START_Y = 2.6;
    const GAP_X = 0.7, GAP_Y = 0.6;

    function emaKey(id){ return `emaComments:${shrine.id}:${id}`; } // 神社ID単位で分離
    function loadEmaComments(id){
      try { return JSON.parse(localStorage.getItem(emaKey(id)) || '[]'); }
      catch(_){ return []; }
    }
    function saveEmaComments(id, arr){
      localStorage.setItem(emaKey(id), JSON.stringify(arr.slice(-100)));
    }
    function short(text, n=14){
      const t = (text || '').replace(/\s+/g,' ').trim();
      return t.length>n ? t.slice(0,n) + '…' : t;
    }
    function addHoverFX(el) {
      el.addEventListener('mouseenter', () => {
        const box = el.querySelector('a-box') || el;
        const color = (box.getAttribute('color') || '#ffffff');
        box.setAttribute('material', `color: ${color}; emissive: #ffffff; emissiveIntensity: 0.15`);
        el.setAttribute('animation__hover',
          'property: scale; to: 1.06 1.06 1.06; dur: 120; easing: easeOutQuad;');
      });
      el.addEventListener('mouseleave', () => {
        const box = el.querySelector('a-box') || el;
        const color = (box.getAttribute('color') || '#ffffff');
        box.setAttribute('material', `color: ${color}; emissiveIntensity: 0`);
        el.removeAttribute('animation__hover');
        el.setAttribute('scale', '1 1 1');
      });
    }
    function pulse(entity) {
      entity.setAttribute('animation__pulse',
        'property: scale; to: 1.05 1.05 1.05; dur: 120; dir: alternate; easing: easeOutQuad');
      setTimeout(()=> entity.removeAttribute('animation__pulse'), 260);
    }

    function createEma(id, x, y, z=0.12){
      const ema = document.createElement('a-entity');
      ema.classList.add('clickable','ema');
      ema.setAttribute('position', `${x} ${y} ${z}`);
      ema.setAttribute('data-ema-id', id);

      const wood = document.createElement('a-box');
      wood.classList.add('clickable');
      wood.setAttribute('color', '#f5d0a0');
      wood.setAttribute('width','0.6'); wood.setAttribute('height','0.38'); wood.setAttribute('depth','0.05');
      ema.appendChild(wood);

      const roof = document.createElement('a-triangle');
      roof.setAttribute('color', '#f1a559');
      roof.setAttribute('vertex-a','-0.33 0.19 0.026');
      roof.setAttribute('vertex-b','0.33 0.19 0.026');
      roof.setAttribute('vertex-c','0 0.38 0.026');
      ema.appendChild(roof);

      const ring = document.createElement('a-torus');
      ring.setAttribute('color','#b45309'); ring.setAttribute('radius','0.06'); ring.setAttribute('radius-tubular','0.008');
      ring.setAttribute('position','0 0.42 0.01'); ema.appendChild(ring);

      const label = document.createElement('a-text');
      label.setAttribute('align','center'); label.setAttribute('width','1.2');
      label.setAttribute('position','0 0.02 0.028'); label.setAttribute('color','#1f2937');
      label.setAttribute('shader','msdf'); label.setAttribute('value','');
      label.classList.add('ema-label'); ema.appendChild(label);

      addHoverFX(ema);
      ema.addEventListener('click', ()=>{ showPanelEma(id); pulse(ema); });
      updateEmaLabelFromStorage(ema, id);
      return ema;
    }
    function updateEmaLabelFromStorage(emaEl, id){
      const comments = loadEmaComments(id);
      const label = emaEl.querySelector('.ema-label');
      if (!label) return;
      if (comments.length === 0) {
        label.setAttribute('value','（願いごとをどうぞ）');
        label.setAttribute('color','#64748b');
      } else {
        const last = comments[comments.length-1];
        label.setAttribute('value', short(last.msg));
        label.setAttribute('color','#1f2937');
      }
    }
    (function spawnEmas(){
      let idSeq = 1;
      for (let r=0; r<4; r++){
        for (let c=0; c<6; c++){
          const x = START_X + c * GAP_X;
          const y = START_Y - r * GAP_Y;
          emaWall.appendChild(createEma(idSeq++, x, y));
        }
      }
    })();
    function renderEmaComments(id){
      const arr = loadEmaComments(id);
      emaCommentsEl.innerHTML = arr.length ? '' : '<div style="opacity:.7;">まだ投稿はありません</div>';
      arr.slice(-100).forEach((o)=>{
        const wrap = document.createElement('div'); wrap.className='comment';
        const meta = document.createElement('div'); meta.className='meta';
        const date = new Date(o.ts).toLocaleString();
        meta.textContent = `${o.name || '名無し'}・${date}`;
        const body = document.createElement('div'); body.textContent = o.msg;
        wrap.appendChild(meta); wrap.appendChild(body); emaCommentsEl.appendChild(wrap);
      });
      emaCommentsEl.scrollTop = emaCommentsEl.scrollHeight;
      msgInput.value = '';
    }
    postBtn.addEventListener('click', ()=>{
      if (!currentEmaId) return;
      const name = nameInput.value.trim();
      const msg = msgInput.value.trim();
      if (!msg){ msgInput.focus(); return; }
      const arr = loadEmaComments(currentEmaId);
      arr.push({name, msg, ts: Date.now()});
      saveEmaComments(currentEmaId, arr);
      renderEmaComments(currentEmaId);
      const emaEl = emaWall.querySelector(`[data-ema-id="${currentEmaId}"]`);
      if (emaEl) updateEmaLabelFromStorage(emaEl, currentEmaId);
    });

    // ===== 鳥居クリックで外へ（地図へ戻る） =====
    const gateExit = document.getElementById('gateExit');
    addHoverFX(gateExit);
    gateExit.addEventListener('click', ()=>{
      window.location.href = `map.html?center=${shrine.lat},${shrine.lng}&zoom=15&id=${encodeURIComponent(shrine.id)}`;
    });

    // ===== クリック演出 =====
    function pulse(entity) {
      entity.setAttribute('animation__pulse',
        'property: scale; to: 1.05 1.05 1.05; dur: 120; dir: alternate; easing: easeOutQuad');
      setTimeout(()=> entity.removeAttribute('animation__pulse'), 260);
    }

    // ===== 矢印キー移動 =====
    AFRAME.registerComponent('arrow-move', {
      schema: { speed: {type: 'number', default: 3} },
      init: function () {
        this.keys = {up:false, down:false, left:false, right:false};
        this.tmpDir = new THREE.Vector3();
        this.right = new THREE.Vector3();
        this.up = new THREE.Vector3(0,1,0);
        this.cameraEl = this.el.querySelector('[camera]');
        window.addEventListener('keydown', (e) => {
          switch (e.key) {
            case 'ArrowUp':    this.keys.up = true; e.preventDefault(); break;
            case 'ArrowDown':  this.keys.down = true; e.preventDefault(); break;
            case 'ArrowLeft':  this.keys.left = true; e.preventDefault(); break;
            case 'ArrowRight': this.keys.right = true; e.preventDefault(); break;
          }
        }, {passive:false});
        window.addEventListener('keyup', (e) => {
          switch (e.key) {
            case 'ArrowUp':    this.keys.up = false; break;
            case 'ArrowDown':  this.keys.down = false; break;
            case 'ArrowLeft':  this.keys.left = false; break;
            case 'ArrowRight': this.keys.right = false; break;
          }
        });
      },
      tick: function (time, dt) {
        if (!this.cameraEl) return;
        const move = (dt / 1000) * this.data.speed;
        if (!(this.keys.up || this.keys.down || this.keys.left || this.keys.right)) return;
        this.cameraEl.object3D.getWorldDirection(this.tmpDir);
        this.tmpDir.y = 0; this.tmpDir.normalize();
        this.right.copy(this.tmpDir).cross(this.up).normalize();
        const dir = new THREE.Vector3();
        if (this.keys.up)    dir.add(this.tmpDir);
        if (this.keys.down)  dir.sub(this.tmpDir);
        if (this.keys.right) dir.add(this.right);
        if (this.keys.left)  dir.sub(this.right);
        if (!dir.lengthSq()) return;
        dir.normalize().multiplyScalar(move);
        this.el.object3D.position.add(dir);
      }
    });
  </script>
</body>
</html>
